
instrument {
    name = "QMS MONITOR DE ROMPIMENTO PRO",
    short_name = "QMS MONITOR PRO",
    icon = "indicators:ATR",
    overlay = true
}

-- =========================================
-- 1. CONFIGURACOES
-- =========================================

input_group {
    "ESTRUTURA",

    periodo = input {
        default = 20,
        type = input.integer,
        min = 5,
        max = 100
    },

    corpo_minimo = input {
        default = 45,
        type = input.integer,
        min = 10,
        max = 90
    },

    fechamento_minimo = input {
        default = 70,
        type = input.integer,
        min = 50,
        max = 95
    }
}

input_group {
    "CORES DOS SINAIS",

    cor_compra = input {
        default = "#2196FF",
        type = input.color
    },

    cor_venda = input {
        default = "#A020F0",
        type = input.color
    },

    cor_reteste = input {
        default = "#FFD700",
        type = input.color
    },

    cor_falso = input {
        default = "#FF3030",
        type = input.color
    },

    cor_neutra = input {
        default = "#808080",
        type = input.color
    }
}

input_group {
    "VISUALIZACAO",

    mostrar_sinais = input {
        default = true,
        type = input.boolean
    },

    mostrar_retestes = input {
        default = true,
        type = input.boolean
    },

    mostrar_falsos = input {
        default = true,
        type = input.boolean
    },

    colorir_candles = input {
        default = true,
        type = input.boolean
    }
}

-- =========================================
-- 2. ESTRUTURA DO MERCADO
-- =========================================

resistencia = highest(high[1], periodo)
suporte = lowest(low[1], periodo)

nivel_anterior_alta = highest(high[2], periodo)
nivel_anterior_baixa = lowest(low[2], periodo)

amplitude = high - low
corpo = abs(close - open)

corpo_percentual =
    corpo / (amplitude + 0.0000001) * 100

posicao_fechamento =
    (close - low) /
    (amplitude + 0.0000001) * 100

-- =========================================
-- 3. FORCA DOS CANDLES
-- =========================================

candle_comprador =
    close > open and
    corpo_percentual >= corpo_minimo and
    posicao_fechamento >= fechamento_minimo

candle_vendedor =
    close < open and
    corpo_percentual >= corpo_minimo and
    posicao_fechamento <=
    (100 - fechamento_minimo)

-- =========================================
-- 4. ROMPIMENTOS
-- =========================================

rompimento_alta =
    close > resistencia and
    close[1] <= resistencia[1]

rompimento_baixa =
    close < suporte and
    close[1] >= suporte[1]

call_forte =
    rompimento_alta and
    candle_comprador

put_forte =
    rompimento_baixa and
    candle_vendedor

-- =========================================
-- 5. RETESTES
-- =========================================

reteste_call =
    close[1] > nivel_anterior_alta and
    low <= nivel_anterior_alta and
    close > nivel_anterior_alta and
    close > open

reteste_put =
    close[1] < nivel_anterior_baixa and
    high >= nivel_anterior_baixa and
    close < nivel_anterior_baixa and
    close < open

-- =========================================
-- 6. IDENTIFICACAO DE FALSO ROMPIMENTO
-- =========================================

falso_rompimento_alta =
    close[1] > resistencia[1] and
    close < resistencia

falso_rompimento_baixa =
    close[1] < suporte[1] and
    close > suporte

falso_rompimento =
    falso_rompimento_alta or
    falso_rompimento_baixa

-- =========================================
-- 7. MANUTENCAO DO ROMPIMENTO
-- =========================================

alta_mantida =
    close > resistencia

baixa_mantida =
    close < suporte

-- =========================================
-- 8. PERDA DE FORCA
-- =========================================

perda_forca_compra =
    close > resistencia and
    close < open

perda_forca_venda =
    close < suporte and
    close > open

-- =========================================
-- 9. DIRECAO DO MERCADO
-- =========================================

direcao_compra =
    call_forte or
    reteste_call or
    (alta_mantida and candle_comprador)

direcao_venda =
    put_forte or
    reteste_put or
    (baixa_mantida and candle_vendedor)

-- =========================================
-- 10. CORES DOS CANDLES
-- =========================================

cor_candle = cor_neutra

if direcao_compra then
    cor_candle = cor_compra
end

if direcao_venda then
    cor_candle = cor_venda
end

if reteste_call or reteste_put then
    cor_candle = cor_reteste
end

if falso_rompimento then
    cor_candle = cor_falso
end

if colorir_candles then
    plot_candle(
        open,
        high,
        low,
        close,
        "MONITOR",
        cor_candle
    )
end

-- =========================================
-- 11. SINAIS CALL E PUT
-- =========================================

plot_shape(
    mostrar_sinais and call_forte,
    "CALL ROMPIMENTO",
    shape_style.triangleup,
    shape_size.large,
    cor_compra,
    shape_location.belowbar
)

plot_shape(
    mostrar_sinais and put_forte,
    "PUT ROMPIMENTO",
    shape_style.triangledown,
    shape_size.large,
    cor_venda,
    shape_location.abovebar
)

-- =========================================
-- 12. SINAIS DE RETESTE
-- =========================================

plot_shape(
    mostrar_retestes and reteste_call,
    "RETESTE CALL",
    shape_style.circle,
    shape_size.small,
    cor_reteste,
    shape_location.belowbar
)

plot_shape(
    mostrar_retestes and reteste_put,
    "RETESTE PUT",
    shape_style.circle,
    shape_size.small,
    cor_reteste,
    shape_location.abovebar
)

-- =========================================
-- 13. SINAIS DE FALSO ROMPIMENTO
-- =========================================

plot_shape(
    mostrar_falsos and falso_rompimento_alta,
    "FALSO ROMPIMENTO ALTA",
    shape_style.triangledown,
    shape_size.large,
    cor_falso,
    shape_location.abovebar
)

plot_shape(
    mostrar_falsos and falso_rompimento_baixa,
    "FALSO ROMPIMENTO BAIXA",
    shape_style.triangleup,
    shape_size.large,
    cor_falso,
    shape_location.belowbar
)

-- =========================================
-- 14. ALERTAS VISUAIS DE PERDA DE FORCA
-- =========================================

plot_shape(
    perda_forca_compra,
    "ATENCAO COMPRA",
    shape_style.circle,
    shape_size.small,
    cor_reteste,
    shape_location.abovebar
)

plot_shape(
    perda_forca_venda,
    "ATENCAO VENDA",
    shape_style.circle,
    shape_size.small,
    cor_reteste,
    shape_location.belowbar
)

-- =========================================
-- 15. LINHAS DE ESTRUTURA
-- =========================================

plot(
    resistencia,
    "RESISTENCIA",
    cor_compra,
    1
)

plot(
    suporte,
    "SUPORTE",
    cor_venda,
    1
)
